{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Solutions Configuration (Server-Only)",
  "description": "Respostes vàlides i secrets. IMPORTANT: Només al servidor, mai accessible al client. Ubicació: content/games/traidor-guixa/private/solutions.json",
  "type": "object",
  "required": [
    "traitor",
    "stations"
  ],
  "properties": {
    "traitor": {
      "type": "string",
      "description": "ID del traïdor (de narrative.json). Exemple: 'bernat'"
    },
    "traitorId": {
      "type": "string",
      "description": "[Opcional] Alias de 'traitor' per claretat"
    },
    "stations": {
      "type": "object",
      "description": "Solucions per a cada estació",
      "additionalProperties": {
        "type": "object",
        "description": "Solucions específiques per a cada estació (estructura depèn del 'type' de stations.json)",
        "properties": {
          "type": {
            "type": "string",
            "description": "Type de joc (coincideix amb stations.json)",
            "enum": [
              "polybiusSquare",
              "dateCalculation",
              "mapNavigation",
              "textComparison",
              "rolePlay",
              "multiChoice",
              "numberInput"
            ]
          },
          "messageVariants": {
            "type": "object",
            "description": "[Per a polybiusSquare] Missatges vàlids per variant A/B/C",
            "properties": {
              "A": {"type": "string"},
              "B": {"type": "string"},
              "C": {"type": "string"}
            }
          },
          "dismissedSuspects": {
            "type": "array",
            "description": "[Per a polybiusSquare] Array de sospitosos descartats",
            "items": {"type": "string"}
          },
          "waterRecollectionDay": {
            "type": "object",
            "description": "[Per a dateCalculation] Data en que es va recollir l'aigua (ISO 8601)",
            "properties": {
              "A": {"type": "string", "format": "date"},
              "B": {"type": "string", "format": "date"},
              "C": {"type": "string", "format": "date"}
            }
          },
          "dismissedSuspect": {
            "type": "string",
            "description": "[Per a dateCalculation] Sospitós descartat per aquesta estació"
          },
          "waterskinCount": {
            "type": "integer",
            "description": "[Per a dateCalculation] Número de càntirs que va portar"
          },
          "blacksmithDeparture": {
            "type": "object",
            "description": "[Per a mapNavigation] Hora que el ferrer va partir (variants A/B/C)",
            "properties": {
              "A": {"type": "string"},
              "B": {"type": "string"},
              "C": {"type": "string"}
            }
          },
          "peasantSighting": {
            "type": "object",
            "description": "[Per a mapNavigation] Hora que el pagès va veure el ferrer",
            "properties": {
              "A": {"type": "string"},
              "B": {"type": "string"},
              "C": {"type": "string"}
            }
          },
          "correctAnswer": {
            "type": "object",
            "description": "[Per a mapNavigation] Hora correcta de resposta (variants A/B/C)",
            "properties": {
              "A": {"type": "string"},
              "B": {"type": "string"},
              "C": {"type": "string"}
            }
          },
          "stonestoneName": {
            "type": "object",
            "description": "[Per a textComparison] Nom del difunt a copiar (variants A/B/C)",
            "properties": {
              "A": {"type": "string"},
              "B": {"type": "string"},
              "C": {"type": "string"}
            }
          },
          "tombstoneWrongSpelling": {
            "type": "object",
            "description": "[Per a textComparison] Com està escrit MALAMENT a la làpida",
            "properties": {
              "A": {"type": "string"},
              "B": {"type": "string"},
              "C": {"type": "string"}
            }
          },
          "properSpelling": {
            "type": "object",
            "description": "[Per a textComparison] Com està escrit CORRECTAMENT al registre",
            "properties": {
              "A": {"type": "string"},
              "B": {"type": "string"},
              "C": {"type": "string"}
            }
          },
          "digit": {
            "type": "integer",
            "description": "Xifra que contribueix al codi final. Exemple: 4, 2, 3, 1",
            "minimum": 0,
            "maximum": 9
          }
        }
      },
      "example": {
        "serrat-bruixes": {
          "type": "polybiusSquare",
          "messageVariants": {
            "A": "SAP DE LLETRA",
            "B": "ESCRIU",
            "C": "LLEGEIX"
          },
          "dismissedSuspects": ["pere-moli", "joan"],
          "digit": 4
        },
        "font-ferro": {
          "type": "dateCalculation",
          "waterRecollectionDay": {
            "A": "1705-05-12",
            "B": "1705-05-11",
            "C": "1705-05-13"
          },
          "dismissedSuspect": "marianna-hostal",
          "waterskinCount": 2,
          "digit": 2
        }
      }
    },
    "accusations": {
      "type": "object",
      "description": "[Per a Jog 6: Acusació] Configuració de l'acusació del traïdor",
      "properties": {
        "correctTraitor": {
          "type": "string",
          "description": "ID del traïdor que s'ha d'acusar. Exemple: 'bernat'"
        },
        "minEvidenceRequired": {
          "type": "integer",
          "description": "Nombre mínim d'evidències vàlides requerida. Exemple: 3",
          "minimum": 1,
          "maximum": 10
        },
        "validEvidences": {
          "type": "array",
          "description": "Array d'IDs de evidence.json que compten per a acusar",
          "items": {
            "type": "string",
            "pattern": "^evidence_[a-z0-9_]+$"
          }
        },
        "wrongAccusationPenalty": {
          "type": "integer",
          "description": "[Opcional] Penalització en minuts si s'acusa el sospitós equivocat. Defecte: 3",
          "minimum": 0,
          "default": 3
        }
      }
    },
    "treasureBox": {
      "type": "object",
      "description": "[Per a Joc 7: Rectoria] Configuració de l'obertura de la caixa de les almoines",
      "properties": {
        "codeParts": {
          "type": "array",
          "description": "Parts del codi que s'han de introduir. Exemple: ['4', '2', '3', '1']",
          "items": {"type": "string"},
          "minItems": 1,
          "maxItems": 4
        },
        "correctSealOption": {
          "type": "string",
          "description": "Opció correcte de segell (A, B, C, D). Exemple: 'A'",
          "enum": ["A", "B", "C", "D"]
        },
        "passwordPhrase": {
          "type": "string",
          "description": "Contrasenya per al segell. Exemple: 'L'alba ve de Vic'",
          "minLength": 1
        }
      }
    },
    "campanile": {
      "type": "object",
      "description": "[Per a Joc 8–9: Campanar] Configuració del sometent i codi final",
      "properties": {
        "correctCode": {
          "type": "string",
          "description": "Codi correcte del campanar. Exemple: '4-2-3-1'",
          "minLength": 1
        },
        "rhyme": {
          "type": "string",
          "description": "Rima que ajuda a desxifrar el codi"
        },
        "codeMeaning": {
          "type": "object",
          "description": "Significat de cada xifra",
          "additionalProperties": {"type": "string"},
          "example": {
            "4": "Serrat de les Bruixes (FOC)",
            "2": "Font del Ferro (AIGUA)",
            "3": "Planes Bones (TERRA)",
            "1": "Cementiri (PEDRA)"
          }
        }
      }
    },
    "moralChoice": {
      "type": "object",
      "description": "[Per a Jog 8: Tracte] Configuració de la decisió moral",
      "properties": {
        "options": {
          "type": "array",
          "description": "Opcions de decisió moral",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": {
                "type": "string",
                "description": "ID de l'opció. Exemple: 'accept' o 'reject'"
              },
              "label": {
                "type": "string",
                "description": "Etiqueta de l'opció per a UI"
              },
              "epilogueId": {
                "type": "string",
                "description": "ID del epíleg (de narrative.json) que aquesta opció activa"
              },
              "timePenalty": {
                "type": "integer",
                "description": "[Opcional] Penalització de temps en minuts. Exemple: 3",
                "minimum": 0
              }
            }
          }
        },
        "timeoutBehavior": {
          "type": "string",
          "description": "Qué passa si no es tria en temps. Exemple: 'default_to_reject'",
          "enum": ["default_to_accept", "default_to_reject", "timeout_loss"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "description": "Temps per decidir en segons. Exemple: 60",
          "minimum": 10,
          "maximum": 300
        }
      }
    },
    "tokens": {
      "type": "object",
      "description": "[Opcional] Configuració de tokens JWT per a validació de QR",
      "properties": {
        "stationQRAlgorithm": {
          "type": "string",
          "description": "Algoritme de signatura (ex: 'HS256')",
          "default": "HS256"
        },
        "tokenExpiry": {
          "type": "integer",
          "description": "Durada del token en segons. Exemple: 60",
          "minimum": 10,
          "maximum": 3600
        },
        "tokenSecret": {
          "type": "string",
          "description": "Secret per signar tokens. IMPORTANTE: mai al client. Usa env vars. Exemple: 'env:PASS_SECRET'",
          "minLength": 16
        }
      }
    },
    "scoring": {
      "type": "object",
      "description": "[Opcional] Configuració de puntuació",
      "properties": {
        "stationSolved": {
          "type": "integer",
          "description": "Punts per estació resolta correctament",
          "minimum": 0,
          "default": 100
        },
        "wrongAnswer": {
          "type": "integer",
          "description": "Punts per resposta incorrecta",
          "maximum": 0,
          "default": -10
        },
        "hintPenalties": {
          "type": "array",
          "description": "Penalitzacions per nivell de pista [1, 2, 3]",
          "items": {"type": "integer", "maximum": 0},
          "minItems": 3,
          "maxItems": 3,
          "default": [0, -2, -5]
        },
        "timeBonus": {
          "type": "string",
          "description": "[Opcional] Com es calcul bonus de temps. Exemple: '5_points_per_minute_under_90'",
          "default": "none"
        },
        "moralChoiceBonus": {
          "type": "string",
          "description": "[Opcional] Si la decisió moral afecta la puntuació. Exemple: 'no_bonus_both_choices_equivalent'",
          "default": "no_bonus_both_choices_equivalent"
        }
      }
    }
  },
  "example": {
    "traitor": "bernat",
    "stations": {
      "serrat-bruixes": {
        "type": "polybiusSquare",
        "messageVariants": {
          "A": "SAP DE LLETRA",
          "B": "ESCRIU",
          "C": "LLEGEIX"
        },
        "dismissedSuspects": ["pere-moli", "joan"],
        "digit": 4
      },
      "font-ferro": {
        "type": "dateCalculation",
        "waterRecollectionDay": {
          "A": "1705-05-12",
          "B": "1705-05-11",
          "C": "1705-05-13"
        },
        "dismissedSuspect": "marianna-hostal",
        "waterskinCount": 2,
        "digit": 2
      }
    },
    "accusations": {
      "correctTraitor": "bernat",
      "minEvidenceRequired": 3,
      "validEvidences": [
        "evidence_firebeacons",
        "evidence_water_ledger",
        "evidence_patrol_route",
        "evidence_tombstone",
        "evidence_calligraphy_sheet"
      ]
    },
    "treasureBox": {
      "codeParts": ["4", "2", "3", "1"],
      "correctSealOption": "A",
      "passwordPhrase": "L'alba ve de Vic"
    },
    "campanile": {
      "correctCode": "4-2-3-1",
      "rhyme": "Del cim baixa l'avís, a la font es fa la tinta, al pla vetlla la ronda i a la pedra dorm el nom.",
      "codeMeaning": {
        "4": "Serrat de les Bruixes (FOC)",
        "2": "Font del Ferro (AIGUA)",
        "3": "Planes Bones (TERRA)",
        "1": "Cementiri (PEDRA)"
      }
    },
    "moralChoice": {
      "options": [
        {
          "id": "accept",
          "label": "Deixar-lo fugir",
          "epilogueId": "accept_deal",
          "timePenalty": 0
        },
        {
          "id": "reject",
          "label": "Lliurar-lo",
          "epilogueId": "reject_deal",
          "timePenalty": 3
        }
      ],
      "timeoutBehavior": "default_to_reject",
      "timeoutSeconds": 60
    },
    "tokens": {
      "stationQRAlgorithm": "HS256",
      "tokenExpiry": 60,
      "tokenSecret": "env:PASS_SECRET"
    },
    "scoring": {
      "stationSolved": 100,
      "wrongAnswer": -10,
      "hintPenalties": [0, -2, -5],
      "timeBonus": "5_points_per_minute_under_90",
      "moralChoiceBonus": "no_bonus_both_choices_equivalent"
    }
  }
}
