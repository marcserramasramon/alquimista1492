{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stations Configuration",
  "description": "Array de 9 (o més) estacions/jocs amb mecànicas, validació, pistes",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "number",
      "name",
      "type",
      "difficulty",
      "estimatedTime",
      "validation",
      "rewards"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Identificador únic de l'estació. Format: 'kebab-case'. Exemple: 'serrat-bruixes'",
        "pattern": "^[a-z0-9-]+$"
      },
      "number": {
        "type": "integer",
        "description": "Número d'estació (1–9, o més). Ordre narratiu.",
        "minimum": 1
      },
      "act": {
        "type": "integer",
        "description": "[Opcional] Número d'acte al qual pertany (1, 2 o 3)"
      },
      "name": {
        "type": "string",
        "description": "Nom de l'estació. Exemple: 'Serrat de les Bruixes'"
      },
      "subtitle": {
        "type": "string",
        "description": "[Opcional] Subtítol o descripció breu. Exemple: 'El Codi de Fogueres'"
      },
      "description": {
        "type": "string",
        "description": "[Opcional] Descripció narrativa de la mecànica. Exemple: 'Els vigies dels turons es passen avisos amb fogueres.'"
      },
      "type": {
        "type": "string",
        "description": "Tipus de joc / mecànica. Determina quin component genèric es carrega.",
        "enum": [
          "polybiusSquare",
          "dateCalculation",
          "mapNavigation",
          "textComparison",
          "rolePlay",
          "multiChoice",
          "numberInput",
          "custom"
        ]
      },
      "difficulty": {
        "type": "integer",
        "description": "Dificultat de l'estació (1–5). Exemple: 2",
        "minimum": 1,
        "maximum": 5
      },
      "estimatedTime": {
        "type": "integer",
        "description": "Temps estimat en minuts (sense desplaçament). Exemple: 8",
        "minimum": 1,
        "maximum": 30
      },
      "params": {
        "type": "object",
        "description": "Paràmetres específics per a aquest type de joc. Estructura depèn de 'type'.",
        "additionalProperties": true,
        "examples": {
          "polybiusSquare": {
            "gridSize": 5,
            "alphabet": "ABCDEFGHIJLMNOPQRSTUVXZÇ·",
            "messageKey": "variants.A.firebeaconMessage"
          },
          "dateCalculation": {
            "baseDate": "1705-05-15",
            "daysBack": 3
          }
        }
      },
      "validation": {
        "type": "object",
        "description": "Defineix com es valida la resposta",
        "required": ["method", "fields"],
        "properties": {
          "method": {
            "type": "string",
            "description": "Mètode de validació",
            "enum": [
              "exactMatch",
              "partialMatch",
              "fuzzy",
              "numeric",
              "multiField"
            ]
          },
          "fields": {
            "type": "array",
            "description": "Array de camps que s'han de validar",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Nom del camp (ex: 'message', 'suspects_dismissed')"
                },
                "type": {
                  "type": "string",
                  "description": "Tipus de dada",
                  "enum": ["string", "array", "number", "boolean"]
                },
                "case_sensitive": {
                  "type": "boolean",
                  "description": "[Opcional] Per a strings. Defecte: false"
                },
                "trim_whitespace": {
                  "type": "boolean",
                  "description": "[Opcional] Per a strings. Defecte: true"
                },
                "solution_key": {
                  "type": "string",
                  "description": "Path a solutions.json. Exemple: 'solutions.serrat-bruixes.messageVariants.A'"
                }
              }
            }
          }
        }
      },
      "hints": {
        "type": "array",
        "description": "[Opcional] Array de 3 pistes (nivell 1, 2, 3) amb cost decreixent de punts",
        "items": {
          "type": "object",
          "required": ["level", "cost", "text"],
          "properties": {
            "level": {
              "type": "integer",
              "description": "Nivell de pista (1, 2, 3)",
              "minimum": 1,
              "maximum": 3
            },
            "cost": {
              "type": "integer",
              "description": "Penalització de punts al revelar pista. Exemple: 0, -2, -5",
              "maximum": 0
            },
            "text": {
              "type": "string",
              "description": "Text de la pista"
            },
            "trigger": {
              "type": "string",
              "description": "[Opcional] Quan es pot revelar. Exemple: 'on_first_hint'"
            }
          }
        }
      },
      "penalties": {
        "type": "object",
        "description": "[Opcional] Penalitzacions per a aquesta estació",
        "properties": {
          "wrong_answer": {
            "type": "integer",
            "description": "Punts per resposta incorrecta. Exemple: -10",
            "maximum": 0
          },
          "timeout": {
            "type": "integer",
            "description": "[Opcional] Punts si s'esgota el temps. Exemple: -15",
            "maximum": 0
          },
          "per_hint": {
            "type": "array",
            "description": "[Opcional] Penalitzacions per hint (alternativa a 'cost' dins hints)",
            "items": {
              "type": "integer",
              "maximum": 0
            },
            "minItems": 3,
            "maxItems": 3
          }
        }
      },
      "rewards": {
        "type": "object",
        "description": "Recompenses per resoldre correctament aquesta estació",
        "required": ["solved"],
        "properties": {
          "solved": {
            "type": "integer",
            "description": "Punts per resoldre correctament. Exemple: 100",
            "minimum": 0
          },
          "digit": {
            "type": "integer",
            "description": "[Opcional] Xifra que contribueix al codi final (4, 2, 3, 1 per a Traïdor). Només per a estacions clau.",
            "minimum": 0,
            "maximum": 9
          },
          "evidence_unlock": {
            "type": "array",
            "description": "[Opcional] Array d'IDs d'evidence.json que es desbloquegen",
            "items": {
              "type": "string",
              "pattern": "^evidence_[a-z0-9_]+$"
            }
          },
          "suspects_dismissed": {
            "type": "array",
            "description": "[Opcional] Array d'IDs de personatges que es descartan com a sospitosos",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        }
      },
      "prerequisite_stations": {
        "type": "array",
        "description": "[Opcional] Estacions que s'han de resoldre primer",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      },
      "prerequisite_conditions": {
        "type": "array",
        "description": "[Opcional] Condicions que s'han de complir (ex: 'bernat_accused')",
        "items": {
          "type": "string"
        }
      },
      "variants": {
        "type": "object",
        "description": "Variants A/B/C del joc (canvien dades però NO mecànica)",
        "properties": {
          "A": {
            "type": "object",
            "description": "Variant A"
          },
          "B": {
            "type": "object",
            "description": "Variant B"
          },
          "C": {
            "type": "object",
            "description": "Variant C"
          }
        }
      },
      "physical_assets": {
        "type": "object",
        "description": "[Opcional] Rutes a fitxers físics necessaris (cartells, QR, imatges)",
        "properties": {
          "sign": {
            "type": "string",
            "description": "Ruta a PDF del cartell. Exemple: 'cartells/serrat-bruixes.pdf'"
          },
          "qr_code": {
            "type": "string",
            "description": "Ruta a SVG del codi QR"
          },
          "illustration": {
            "type": "string",
            "description": "Ruta a imatge il·lustrada"
          }
        }
      },
      "narrative": {
        "type": "object",
        "description": "[Opcional] Textos narratius per a aquesta estació",
        "properties": {
          "introduction": {
            "type": "string",
            "description": "Text al arribar a l'estació"
          },
          "on_solve": {
            "type": "string",
            "description": "Text al resoldre correctament"
          },
          "on_fail": {
            "type": "string",
            "description": "Text al fallar"
          }
        }
      }
    }
  },
  "example": [
    {
      "id": "serrat-bruixes",
      "number": 1,
      "act": 1,
      "name": "Serrat de les Bruixes",
      "subtitle": "El Codi de Fogueres",
      "description": "Els vigies dels turons es passen avisos amb fogueres.",
      "type": "polybiusSquare",
      "difficulty": 2,
      "estimatedTime": 8,
      "params": {
        "gridSize": 5,
        "alphabet": "ABCDEFGHIJLMNOPQRSTUVXZÇ·",
        "messageKey": "variants.A.firebeaconMessage"
      },
      "validation": {
        "method": "exactMatch",
        "fields": [
          {
            "name": "message",
            "type": "string",
            "case_sensitive": false,
            "trim_whitespace": true,
            "solution_key": "solutions.serrat-bruixes.messageVariants.A"
          },
          {
            "name": "suspects_dismissed",
            "type": "array",
            "solution_key": "solutions.serrat-bruixes.dismissedSuspects"
          }
        ]
      },
      "hints": [
        {
          "level": 1,
          "cost": 0,
          "text": "Cada missatge són parells de fogueres."
        },
        {
          "level": 2,
          "cost": -2,
          "text": "El primer parell és una sola lletra: fila i columna."
        },
        {
          "level": 3,
          "cost": -5,
          "text": "La solució és: SAP DE LLETRA"
        }
      ],
      "rewards": {
        "solved": 100,
        "digit": 4,
        "evidence_unlock": ["evidence_firebeacons"],
        "suspects_dismissed": ["pere-moli", "joan"]
      },
      "variants": {
        "A": {
          "message": "SAP DE LLETRA",
          "sequence": "4-3 · 1-1 · 3-5 / 3-1 · 3-1 · 1-5 · 4-4 · 4-2 · 1-1"
        },
        "B": {
          "message": "ESCRIU",
          "sequence": "1-5 · 4-3 · 1-3 · 4-2 · 2-4 · 4-5"
        },
        "C": {
          "message": "LLEGEIX",
          "sequence": "3-1 · 3-1 · 1-5 · 2-2 · 1-5 · 2-4 · 5-2"
        }
      },
      "physical_assets": {
        "sign": "cartells/serrat-bruixes.pdf",
        "qr_code": "qr/serrat-bruixes.svg"
      },
      "narrative": {
        "introduction": "Els vigies parlen de nit amb fogueres.",
        "on_solve": "Has descobert que el delator sap escriure."
      }
    }
  ]
}
